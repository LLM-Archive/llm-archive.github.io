{
  "tvd": [
    {
      "name": "identical_shares_different_n",
      "note": "3/6 vs 6/12 are the same 50/50 split at different sample sizes -> distance 0",
      "cx": [
        3,
        3
      ],
      "cy": [
        6,
        6
      ],
      "expected": "0"
    },
    {
      "name": "fully_disjoint",
      "note": "everything picked under X was never picked under Y -> maximum distance 1",
      "cx": [
        5,
        0
      ],
      "cy": [
        0,
        5
      ],
      "expected": "1"
    },
    {
      "name": "zero_valid_on_one_side",
      "note": "no valid responses on one side -> no distribution to compare, so None (not 0 or 1)",
      "cx": [
        0,
        0
      ],
      "cy": [
        3,
        2
      ],
      "expected": null
    },
    {
      "name": "partial_overlap",
      "note": "3:1 vs 1:3 out of 4 each -> exact fraction 1/2, not a rounded float",
      "cx": [
        3,
        1
      ],
      "cy": [
        1,
        3
      ],
      "expected": "1/2"
    }
  ],
  "drop_bound_pct": [
    {
      "name": "typical",
      "note": "10% loss on one side plus 5% on the other -> a 15-point worst-case ceiling",
      "u_x": "1/10",
      "u_y": "1/20",
      "expected": "15"
    },
    {
      "name": "no_loss",
      "note": "nothing lost on either side -> the ceiling is exactly 0, not just small",
      "u_x": "0",
      "u_y": "0",
      "expected": "0"
    }
  ],
  "entropy_norm": [
    {
      "name": "uniform_two_options",
      "note": "an even 5/5 split over 2 options is maximally spread -> 1.0",
      "c": [
        5,
        5
      ],
      "expected": 1.0
    },
    {
      "name": "always_same_answer",
      "note": "every response picked the same option -> 0.0, not just low",
      "c": [
        10,
        0
      ],
      "expected": 0.0
    },
    {
      "name": "no_valid_responses",
      "note": "n=0 -> nothing to compute entropy over -> None",
      "c": [
        0,
        0
      ],
      "expected": null
    },
    {
      "name": "single_option_undefined",
      "note": "k<2: with only one possible option, entropy is undefined, not trivially 0",
      "c": [
        7
      ],
      "expected": null
    },
    {
      "name": "skewed_two_options",
      "note": "a 3:1 split, checked against the exact closed-form value",
      "c": [
        3,
        1
      ],
      "expected": 0.811278124459
    },
    {
      "name": "three_options",
      "note": "entropy generalizes past two options, normalized by log(k)=log(3)",
      "c": [
        2,
        3,
        5
      ],
      "expected": 0.937230563216
    }
  ],
  "null_floor": [
    {
      "name": "seed_42_default_iterations",
      "note": "same seed must reproduce bit-for-bit; iterations = the frozen production B_ITERATIONS",
      "cx": [
        5,
        3
      ],
      "cy": [
        2,
        6
      ],
      "seed": 42,
      "iterations": 10000,
      "expected": "8589/40000"
    },
    {
      "name": "seed_7_reduced_iterations",
      "note": "a different seed and a smaller iteration count exercise the loop's early-exit shape",
      "cx": [
        10,
        0
      ],
      "cy": [
        0,
        10
      ],
      "seed": 7,
      "iterations": 500,
      "expected": "441/2500"
    },
    {
      "name": "zero_valid_on_one_side",
      "note": "same missing-distribution rule as tvd: nothing to pool -> None, seed is irrelevant",
      "cx": [
        0,
        0
      ],
      "cy": [
        3,
        2
      ],
      "seed": 1,
      "iterations": 10000,
      "expected": null
    }
  ],
  "gate_ab": [
    {
      "name": "clean_pass",
      "note": "every check on every pair clears -> no flags at all",
      "gap_pct": {
        "ab": "3",
        "aa": "0",
        "ac": "50"
      },
      "bound": {
        "ab": "1",
        "aa": "1",
        "ac": "1"
      },
      "asym": {
        "ab": "0",
        "aa": "0",
        "ac": "0"
      },
      "theta": "10",
      "expected": {
        "gates": {
          "A-B": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_drop_bound": true
          },
          "A-A_prime": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_surface_noise": true
          },
          "A-C": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "reading": true
          }
        },
        "flags": [],
        "unset": []
      }
    },
    {
      "name": "drop_confounded",
      "note": "bound_ab=3 exceeds the frozen 2.0-point ceiling -> drop_bound_ok False",
      "gap_pct": {
        "ab": "10",
        "aa": "0",
        "ac": "50"
      },
      "bound": {
        "ab": "3",
        "aa": "1",
        "ac": "1"
      },
      "asym": {
        "ab": "0",
        "aa": "0",
        "ac": "0"
      },
      "theta": "10",
      "expected": {
        "gates": {
          "A-B": {
            "drop_bound_ok": false,
            "asymmetry_ok": true,
            "above_drop_bound": true
          },
          "A-A_prime": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_surface_noise": true
          },
          "A-C": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "reading": true
          }
        },
        "flags": [
          "drop_confounded"
        ],
        "unset": []
      }
    },
    {
      "name": "asymmetric_missingness",
      "note": "asym_ab=1.5 exceeds the frozen 1.0-point ceiling -> asymmetry_ok False",
      "gap_pct": {
        "ab": "10",
        "aa": "0",
        "ac": "50"
      },
      "bound": {
        "ab": "1",
        "aa": "1",
        "ac": "1"
      },
      "asym": {
        "ab": "3/2",
        "aa": "0",
        "ac": "0"
      },
      "theta": "10",
      "expected": {
        "gates": {
          "A-B": {
            "drop_bound_ok": true,
            "asymmetry_ok": false,
            "above_drop_bound": true
          },
          "A-A_prime": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_surface_noise": true
          },
          "A-C": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "reading": true
          }
        },
        "flags": [
          "asymmetric_missingness"
        ],
        "unset": []
      }
    },
    {
      "name": "below_drop_bound_implies_below_surface_noise",
      "note": "bound_ab(2) >= gap_ab(1) so the finding can't clear its own worst-case error; this ALWAYS also fails the A-A' noise gate too, because gap_ab-bound_ab<=0<=gap_aa+bound_aa always holds -- not a coincidence of these numbers, a mathematical consequence of both bounds being non-negative",
      "gap_pct": {
        "ab": "1",
        "aa": "0",
        "ac": "50"
      },
      "bound": {
        "ab": "2",
        "aa": "1",
        "ac": "1"
      },
      "asym": {
        "ab": "0",
        "aa": "0",
        "ac": "0"
      },
      "theta": "10",
      "expected": {
        "gates": {
          "A-B": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_drop_bound": false
          },
          "A-A_prime": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_surface_noise": false
          },
          "A-C": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "reading": true
          }
        },
        "flags": [
          "below_drop_bound",
          "below_surface_noise"
        ],
        "unset": []
      }
    }
  ],
