        "ac": "1"
      },
      "asym": {
        "ab": "0",
        "aa": "0",
        "ac": "0"
      },
      "theta": "10",
      "expected": {
        "gates": {
          "A-B": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_drop_bound": true
          },
          "A-A_prime": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "above_surface_noise": false
          },
          "A-C": {
            "drop_bound_ok": true,
            "asymmetry_ok": true,
            "reading": true
          }
        },
        "flags": [
          "below_surface_noise"
        ],
        "unset": []
      }
    }
