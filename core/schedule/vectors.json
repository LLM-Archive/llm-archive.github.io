{
  "parse_cadence": [
    {
      "name": "mixed_fields",
      "text": "subject_fingerprint: 1d   # daily\nfull_sweep: 30d\ndeadman_alert: 36h\nrevalidation_daily: 10\nbridge_reserve_monthly: 0.40\nactive_switch: provider_declared_successor\nopen_weights_series: on_new_generation\n",
      "expected": {
        "subject_fingerprint": 1,
        "full_sweep": 30,
        "deadman_alert": 1.5
      }
    }
  ],
  "due_jobs": [
    {
      "name": "never_run",
      "intervals": {"subject_fingerprint": 1},
      "last_run": {},
      "today": "2026-09-20",
      "expected": {"subject_fingerprint": {"due": true, "elapsed_days": null}}
    },
    {
      "name": "ran_today_not_due",
      "intervals": {"subject_fingerprint": 1},
      "last_run": {"subject_fingerprint": "2026-09-20"},
      "today": "2026-09-20",
      "expected": {"subject_fingerprint": {"due": false, "elapsed_days": 0}}
    },
    {
      "name": "exactly_at_interval_is_due",
      "intervals": {"full_sweep": 30},
      "last_run": {"full_sweep": "2026-08-21"},
      "today": "2026-09-20",
      "expected": {"full_sweep": {"due": true, "elapsed_days": 30}}
    },
    {
      "name": "one_day_short_not_due",
      "intervals": {"full_sweep": 30},
      "last_run": {"full_sweep": "2026-08-22"},
      "today": "2026-09-20",
      "expected": {"full_sweep": {"due": false, "elapsed_days": 29}}
    }
  ],
  "plan": [
    {
      "name": "nothing_due",
      "due": {"subject_fingerprint": {"due": false}, "full_sweep": {"due": false}},
      "expected": {}
    },
    {
      "name": "known_jobs_grouped_by_runner",
      "due": {
        "subject_fingerprint": {"due": true},
        "full_sweep": {"due": true},
        "runtime_fingerprint": {"due": true},
        "guard_margin_rotation": {"due": true}
      },
      "expected": {
        "subject_fingerprint": ["subject_fingerprint"],
        "full_sweep": ["full_sweep"],
        "reference_model": ["runtime_fingerprint", "guard_margin_rotation"]
      }
    },
    {
      "name": "only_one_of_the_shared_pair_due",
      "due": {"runtime_fingerprint": {"due": true}, "guard_margin_rotation": {"due": false}},
      "expected": {"reference_model": ["runtime_fingerprint"]}
    },
    {
      "name": "unknown_cadence_jobs_left_out",
      "due": {"human_review": {"due": true}, "deadman_alert": {"due": true}},
      "expected": {}
    }
  ],
  "record_run": [
    {
      "name": "valid_date_roundtrips",
      "job": "subject_fingerprint",
      "run_date": "2026-09-20",
      "expect_error": false
    },
    {
      "name": "bad_date_rejected_immediately",
      "note": "must fail inside record_run itself, not silently write and blow up later in due_jobs",
      "job": "subject_fingerprint",
      "run_date": "not-a-date",
      "expect_error": true
    }
  ],
  "gap_cause_for": [
    {
      "name": "full_sweep_budget_halted_has_an_honest_match",
      "runner": "full_sweep",
      "skip_reasons": ["budget_halted"],
      "expected": "budget_halted"
    },
    {
      "name": "reference_model_environment_unavailable_deliberately_unmapped",
      "note": "no schema.GAP_CAUSES value honestly fits a local dev machine missing llama_cpp -- see coverage.py's docstring",
      "runner": "reference_model",
      "skip_reasons": ["environment_unavailable"],
      "expected": null
    },
    {
      "name": "subject_fingerprint_never_produces_a_still_due_skip_today",
      "runner": "subject_fingerprint",
      "skip_reasons": ["budget_halted"],
      "expected": null
    },
    {
      "name": "mixed_reasons_is_not_one_honest_cause",
      "runner": "full_sweep",
      "skip_reasons": ["budget_halted", "environment_unavailable"],
      "expected": null
    },
    {
      "name": "empty_reasons",
      "runner": "full_sweep",
      "skip_reasons": [],
      "expected": null
    }
  ],
  "record_observation": [
    {
      "name": "ran_true_roundtrips",
      "job": "subject_fingerprint",
      "date": "2026-09-22",
      "ran": true,
      "cause": null,
      "expect_error": false
    },
    {
      "name": "gap_with_valid_cause_roundtrips",
      "job": "full_sweep",
      "date": "2026-09-22",
      "ran": false,
      "cause": "budget_halted",
      "expect_error": false
    },
    {
      "name": "unknown_job_rejected",
      "job": "release_publish",
      "date": "2026-09-22",
      "ran": false,
      "cause": "budget_halted",
      "expect_error": true
    },
    {
      "name": "gap_with_invalid_cause_rejected",
      "note": "must never write a coverage_gap cause outside schema.GAP_CAUSES's closed list",
      "job": "full_sweep",
      "date": "2026-09-22",
      "ran": false,
      "cause": "server_on_fire",
      "expect_error": true
    },
    {
      "name": "ran_true_with_a_cause_rejected",
      "note": "a real run doesn't get a gap cause attached, even a valid-looking one",
      "job": "full_sweep",
      "date": "2026-09-22",
      "ran": true,
      "cause": "budget_halted",
      "expect_error": true
    },
    {
      "name": "bad_date_rejected_immediately",
      "job": "full_sweep",
      "date": "not-a-date",
      "ran": true,
      "cause": null,
      "expect_error": true
    }
  ]
}
