      "expected": {
        "subject_fingerprint": 1,
        "full_sweep": 30,
        "deadman_alert": 1.5
      }
    }
  ],
  "due_jobs": [
    {
      "name": "never_run",
      "intervals": {"subject_fingerprint": 1},
      "last_run": {},
      "today": "2026-09-20",
      "expected": {"subject_fingerprint": {"due": true, "elapsed_days": null}}
    },
    {
      "name": "ran_today_not_due",
      "intervals": {"subject_fingerprint": 1},
      "last_run": {"subject_fingerprint": "2026-09-20"},
      "today": "2026-09-20",
      "expected": {"subject_fingerprint": {"due": false, "elapsed_days": 0}}
    },
    {
      "name": "exactly_at_interval_is_due",
      "intervals": {"full_sweep": 30},
      "last_run": {"full_sweep": "2026-08-21"},
      "today": "2026-09-20",
      "expected": {"full_sweep": {"due": true, "elapsed_days": 30}}
    },
    {
      "name": "one_day_short_not_due",
      "intervals": {"full_sweep": 30},
      "last_run": {"full_sweep": "2026-08-22"},
      "today": "2026-09-20",
      "expected": {"full_sweep": {"due": false, "elapsed_days": 29}}
    }
  ],
  "plan": [
    {
      "name": "nothing_due",
      "due": {"subject_fingerprint": {"due": false}, "full_sweep": {"due": false}},
      "expected": {}
    },
    {
      "name": "known_jobs_grouped_by_runner",
      "due": {
        "subject_fingerprint": {"due": true},
        "full_sweep": {"due": true},
        "runtime_fingerprint": {"due": true},
        "guard_margin_rotation": {"due": true}
